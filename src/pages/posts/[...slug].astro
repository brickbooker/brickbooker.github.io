---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const gasWebAppUrl = import.meta.env.PUBLIC_GAS_WEBAPP_URL || '';

function formatDate(date: Date) {
  return date.toISOString().slice(0, 7);
}

function formatCategory(category: string) {
  if (category === 'brick-by-brick') return 'Brick by Brick';
  if (category === 'book-unfolded') return 'Book Unfolded';
  return category;
}

const postUrl = `https://brickbooker.github.io/posts/${post.id}/`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': postUrl,
  },
  headline: post.data.title,
  description: post.data.description || (post.data.bricks ?? []).join(', '),
  datePublished: post.data.date.toISOString().slice(0, 10),
  url: postUrl,
  inLanguage: 'ko',
  articleSection: formatCategory(post.data.category),
  keywords: post.data.bricks ?? [],
  author: {
    '@type': 'Person',
    name: 'brickbooker',
    url: 'https://brickbooker.github.io/about/',
  },
  publisher: {
    '@type': 'Organization',
    name: 'brickbooker',
    url: 'https://brickbooker.github.io/',
  },
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  jsonLd={jsonLd}
>
  <a href="/" class="back-link">← Posts</a>

  <article>
    <header class="article-header">
      <div class="post-meta">
        <time datetime={post.data.date.toISOString()}>
          {formatDate(post.data.date)}
        </time>
        <span class="post-category">{formatCategory(post.data.category)}</span>
      </div>
      <h1 class="article-title">{post.data.title}</h1>
    </header>

    <div class="prose">
      <Content />
    </div>

    <aside class="note-extension" data-gas-url={gasWebAppUrl} data-post-title={post.data.title}>
      <div class="note-trigger-row">
        <button type="button" id="note-toggle" class="note-toggle">Send feedback</button>
      </div>
      <form id="note-form" class="note-form" hidden>
        <input
          type="text"
          name="website"
          id="note-honeypot"
          class="note-honeypot"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
        />
        <div class="note-input-row">
          <input
            type="text"
            id="note-input"
            class="note-input"
            placeholder="이 글에 대한 피드백을 남깁니다..."
            maxlength="500"
            autocomplete="off"
            required
          />
          <div class="note-actions">
            <button type="submit" class="note-submit">send</button>
            <span class="note-sep" aria-hidden="true">/</span>
            <button type="button" id="note-close" class="note-close">close</button>
          </div>
        </div>
      </form>
    </aside>
  </article>

  <script is:inline>
    (function () {
      const container = document.querySelector('.note-extension');
      const toggleBtn = document.getElementById('note-toggle');
      const form = document.getElementById('note-form');
      const input = document.getElementById('note-input');
      const closeBtn = document.getElementById('note-close');
      const honeypot = document.getElementById('note-honeypot');

      if (!container || !toggleBtn || !form || !input || !closeBtn) return;

      const gasUrl = container.getAttribute('data-gas-url') || '';
      const postTitle = container.getAttribute('data-post-title') || document.title;

      toggleBtn.addEventListener('click', function () {
        if (toggleBtn.textContent === 'Feedback sent.') return;
        const isHidden = form.hasAttribute('hidden');
        if (isHidden) {
          form.removeAttribute('hidden');
          toggleBtn.setAttribute('hidden', '');
          input.focus();
        }
      });

      closeBtn.addEventListener('click', function () {
        form.setAttribute('hidden', '');
        input.value = '';
        toggleBtn.removeAttribute('hidden');
      });

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        const message = input.value.trim();
        if (!message) return;

        const trap = honeypot ? honeypot.value : '';
        if (!trap && gasUrl) {
          fetch(gasUrl, {
            method: 'POST',
            mode: 'no-cors',
            headers: { 'Content-Type': 'text/plain;charset=utf-8' },
            body: JSON.stringify({
              postTitle: postTitle,
              postPath: window.location.pathname,
              message: message,
              timestamp: new Date().toISOString(),
            }),
          }).catch(function () {});
        }

        input.value = '';
        form.setAttribute('hidden', '');
        toggleBtn.textContent = 'Feedback sent.';
        toggleBtn.removeAttribute('hidden');

        setTimeout(function () {
          toggleBtn.textContent = 'Send feedback';
        }, 3000);
      });
    })();
  </script>
</BaseLayout>
